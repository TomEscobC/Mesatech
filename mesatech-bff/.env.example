# BFF (EC2-A). Cargar con EnvironmentFile de systemd; este archivo NO lleva valores reales.
SPRING_PROFILES_ACTIVE=prod
AZURE_TENANT_ID=<tenant-id>
# URI y GUID de la API (el token v2 trae uno de los dos en aud); el BFF acepta cualquiera de la lista
AZURE_AUDIENCE=api://<client-id-api>,<client-id-api>
SERVICES_CATALOGO_URL=http://localhost:8082
SERVICES_SOLICITUDES_URL=http://<ip-privada-EC2-B>:8081
CORS_ALLOWED_ORIGINS=http://localhost:3000
