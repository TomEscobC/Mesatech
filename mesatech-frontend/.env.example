# MesaTech Frontend (React). Copiar a .env (no se versiona).
REACT_APP_AZURE_CLIENT_ID=<client-id-de-la-SPA>
REACT_APP_AZURE_TENANT_ID=<tenant-id>
# Scope de la API 'api-cloud-native': el URI lleva el Client ID de la API (api://<client-id-api>/access_as_user)
REACT_APP_API_SCOPE=api://<client-id-api>/access_as_user
# URL de AWS API Gateway (HTTP API). El frontend NO llama al BFF directamente.
REACT_APP_API_GATEWAY_URL=https://<api-id>.execute-api.<region>.amazonaws.com
